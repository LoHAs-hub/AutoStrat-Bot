{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "KnowledgeUnit v0.1 (planned)",
  "required": [
    "id",
    "version",
    "kind",
    "claim",
    "source_ids",
    "available_at",
    "status",
    "instrument"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "fact",
        "hypothesis",
        "procedure",
        "preference"
      ]
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "source_locator": {
      "type": [
        "string",
        "null"
      ]
    },
    "instrument": {
      "type": "string"
    },
    "available_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_due_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "enum": [
        "unverified",
        "reviewed",
        "disputed",
        "stale",
        "retired"
      ]
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contradicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_hash": {
      "type": "string"
    }
  }
}
